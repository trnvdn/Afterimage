# Copy to .env and adjust. .env is git-ignored; .env.example is committed.
# These are LOCAL DEVELOPMENT defaults only — never reuse them anywhere real.

# --- Postgres ---
POSTGRES_USER=afterimage
POSTGRES_PASSWORD=afterimage_dev_pw
POSTGRES_DB=afterimage

# --- MinIO (root password must be at least 8 characters) ---
MINIO_ROOT_USER=afterimage
MINIO_ROOT_PASSWORD=afterimage_dev_pw

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=afterimage
RABBITMQ_DEFAULT_PASS=afterimage_dev_pw
